# StudyMate-v2 root .gitignore

# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Node / frontend
node_modules/
dist/
build/
dist-ssr/
*.tsbuildinfo
*.local

# Environment and secrets
.env
.env.*
!.env.example

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Generated artifacts and runtime data
test_env/
audio_benchmark_report.json
backend/security_audit_report.json

# ── backend data directories ────────────────────────────────────────────────
# Pattern: ignore dir contents but keep the dir structure via .gitkeep.
# The specific backend/* rules must come BEFORE any catch-all patterns below.

backend/cache/*
!backend/cache/.gitkeep
!backend/cache/transcriptions/
backend/cache/transcriptions/*
!backend/cache/transcriptions/.gitkeep
!backend/cache/processed/
backend/cache/processed/*
!backend/cache/processed/.gitkeep

backend/models/*
!backend/models/.gitkeep

backend/uploads/*
!backend/uploads/.gitkeep

backend/processed/*
!backend/processed/.gitkeep

backend/temp_chunks/*
!backend/temp_chunks/.gitkeep

backend/rnnoise_output/*
!backend/rnnoise_output/.gitkeep

# App-level runtime dirs (created automatically on first run — no .gitkeep needed)
backend/app/uploads/
backend/app/output/
backend/app/processed/

# Storage-layer local fallback dirs (used when USE_S3_STORAGE=false)
backend/utils/uploads/
backend/utils/cache/

# ── catch-all for any other cache/upload/output dirs not listed above ───────
# NOTE: These broad patterns intentionally come AFTER the backend-specific
# rules above (git evaluates rules in order; last match wins).  They will
# match root-level or other nested dirs named cache/, uploads/, etc., but
# will NOT affect backend/* paths already handled above.
/cache/
/models/
/output/
/uploads/
/processed/
/temp_chunks/
/rnnoise_output/

# Large media files and temporary binaries
*.wav
*.mp3
*.mp4
*.avi
*.mov
*.mkv
*.flac
*.aac
*.rnnn
*.tmp
*.temp

# Desloppify (local scan state; do not commit)
.desloppify/
scorecard.png

# Misc
*.db
*.sqlite
*.sqlite3
*.orig
*.rej
*.backup
MVP_COMPLETION_REPORT.md.backup
