# API Configuration
VITE_API_BASE_URL=http://localhost:8000

# Google OAuth (GIS) — must match a "Web application" OAuth client. In Google Cloud Console,
# add Authorized JavaScript origins for every dev URL you use, e.g.:
#   http://localhost:5173  and  http://127.0.0.1:5173  (both if you switch between them).
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com